# ─── Google Calendar (lecture des créneaux — côté serveur uniquement) ────────
# La clé API reste côté serveur (secret GOOGLE_API_KEY), jamais dans le bundle client.
GOOGLE_API_KEY=AIzaSy_VOTRE_CLE_ICI

# ─── Google Calendar Service Account (écriture des événements) ───────────────
# 1. console.cloud.google.com → IAM & Admin → Comptes de service
# 2. Créer un compte de service → créer une clé JSON
# 3. Dans Google Calendar : partager le calendrier avec l'email du service account
#    → Permission "Apporter des modifications aux événements"
GCAL_SERVICE_ACCOUNT_EMAIL=cleanfresh-booking@xxx.iam.gserviceaccount.com
GCAL_SERVICE_ACCOUNT_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GCAL_CALENDAR_ID=votreadresse@gmail.com

# ─── EmailJS (envoi d'emails) ─────────────────────────────────────────────────
# 1. Créer un compte sur https://www.emailjs.com
# 2. Email Services → Add Service → Gmail
# 3. Créer 4 templates (voir la documentation dans emailService.ts)
# 4. Account → API Keys → Public Key
VITE_EMAILJS_PUBLIC_KEY=votre_cle_publique
VITE_EMAILJS_SERVICE_ID=service_xxxxxx
VITE_EMAILJS_TEMPLATE_CLIENT=template_xxxxxx   # Confirmation client
VITE_EMAILJS_TEMPLATE_OWNER=template_xxxxxx    # Notification propriétaire
VITE_EMAILJS_TEMPLATE_CANCEL=template_xxxxxx   # Annulation
VITE_EMAILJS_TEMPLATE_REMINDER=template_xxxxxx # Rappel 24h (client uniquement)

# ─── Site ─────────────────────────────────────────────────────────────────────
VITE_SITE_URL=https://cleanfresh-toulouse.fr

# ─── Contact professionnel (affiché dans tous les emails + Google Agenda) ─────
VITE_OWNER_PHONE=07 67 12 75 00
VITE_OWNER_EMAIL=nettoyagecleanfresh@gmail.com
